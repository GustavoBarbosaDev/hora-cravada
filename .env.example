# Usado ao rodar a API fora do Docker. No compose os valores já estão definidos.
ENVIRONMENT=development
LOG_LEVEL=INFO
# A API usa hora_app (sem BYPASSRLS, criado pela migration 0002); as migrations usam o dono do schema.
DATABASE_URL=postgresql+asyncpg://hora_app:hora_app@localhost:5432/hora_cravada
MIGRATION_DATABASE_URL=postgresql+asyncpg://hora:hora@localhost:5432/hora_cravada
TEST_DATABASE_URL=postgresql+asyncpg://hora:hora@localhost:5432/hora_cravada_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=segredo-de-desenvolvimento-local
