<!doctype html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#f4f1ec;font-family:Arial,Helvetica,sans-serif;color:#1f1b16;">
  <table role="presentation" width="100%" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:8px;">
    <tr>
      <td style="padding:28px 28px 8px;">
        <p style="margin:0;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#7a6f63;">{{ tenant_name }}</p>
        <h1 style="margin:8px 0 0;font-size:22px;">{% block heading %}{% endblock %}</h1>
      </td>
    </tr>
    <tr>
      <td style="padding:8px 28px 28px;font-size:15px;line-height:1.5;">
        {% block body %}{% endblock %}
        <table role="presentation" style="margin:20px 0;border-collapse:collapse;">
          <tr><td style="padding:4px 16px 4px 0;color:#7a6f63;">Serviço</td><td>{{ service_name }}</td></tr>
          <tr><td style="padding:4px 16px 4px 0;color:#7a6f63;">Quando</td><td>{{ start | local_datetime(timezone) }}</td></tr>
          {% if resource_names %}
          <tr><td style="padding:4px 16px 4px 0;color:#7a6f63;">Com</td><td>{{ resource_names | join(", ") }}</td></tr>
          {% endif %}
          <tr><td style="padding:4px 16px 4px 0;color:#7a6f63;">Local</td><td>{{ branch_name }}{% if branch_address %}, {{ branch_address }}{% endif %}</td></tr>
          <tr><td style="padding:4px 16px 4px 0;color:#7a6f63;">Valor</td><td>{{ price_cents | brl }}</td></tr>
        </table>
        {% if notes %}<p style="margin:0;color:#7a6f63;">Observações: {{ notes }}</p>{% endif %}
      </td>
    </tr>
  </table>
</body>
</html>
